# SuperNova Tools — Environment Variables
# Copy this file to .env.local and fill in values

# Phase 2: Google Sheets Integration
# Base64-encoded service account JSON for Google Sheets API access
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Sheet ID containing FB Ads data (from Make.com sync)
FB_ADS_SHEET_ID=

# Phase 3: AI Analysis (existing key, shared with tournament calculator)
ANTHROPIC_API_KEY=

# Tournament Lite — standalone Apps Script backend (server-side proxy only).
# SERVER-ONLY: never prefix with NEXT_PUBLIC_; the secret must not reach the browser.
# Put real TEST values in .env.local (gitignored), not here.
TOURNAMENT_LITE_EXEC_URL=
TOURNAMENT_LITE_ADMIN_SECRET=

# Tournament Lite — admin console access guard (server-only; never NEXT_PUBLIC_).
# PASSCODE: what an admin types on /tournaments/login.
# SESSION_TOKEN: server-only HMAC signing key (generate a long random string).
# Cookies carry signed, expiring session IDs; Apps Script stores revocation state.
TOURNAMENT_LITE_ADMIN_PASSCODE=
TOURNAMENT_LITE_ADMIN_SESSION_TOKEN=
